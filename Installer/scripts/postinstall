#!/bin/zsh
# Uruchamia Privio po zakończeniu instalacji. Instalator działa jako root, więc
# aplikację GUI startujemy w sesji zalogowanego użytkownika przez `launchctl asuser`.
console_user=$(/usr/bin/stat -f%Su /dev/console 2>/dev/null)
if [[ -n "$console_user" && "$console_user" != "root" ]]; then
  uid=$(/usr/bin/id -u "$console_user" 2>/dev/null)
  if [[ -n "$uid" ]]; then
    /bin/launchctl asuser "$uid" /usr/bin/open -a "/Applications/Privio.app" 2>/dev/null || true
  fi
fi
exit 0
