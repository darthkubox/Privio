{
  "manifest_version": 2,
  "name": "Privio Website Protection",
  "version": "0.2.0",
  "description": "Blocks Privio-protected websites in Firefox (Touch ID unlock), matching the Privio Chromium extension.",
  "browser_specific_settings": {
    "gecko": {
      "id": "website-protection@privio.app",
      "strict_min_version": "91.0"
    }
  },
  "permissions": [
    "proxy",
    "storage",
    "alarms",
    "tabs",
    "webNavigation",
    "webRequest",
    "webRequestBlocking",
    "<all_urls>",
    "http://127.0.0.1:8987/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["compat.js", "blocker.js"],
    "run_at": "document_start",
    "all_frames": false
  }],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_action": {
    "default_title": "Privio Website Protection",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16-active.png",
      "32": "icons/icon32-active.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    "unlock.html",
    "unlock.js",
    "unlock.css",
    "i18n.js",
    "icons/icon128.png"
  ]
}
