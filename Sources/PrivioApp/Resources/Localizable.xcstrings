      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukryj aplikacje"
          }
        }
      }
    },
    "Hide protected app windows on demand. Configure it in the Privacy Curtain section.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukrywaj okna chronionych aplikacji na żądanie. Skonfiguruj w sekcji Zasłona prywatności."
          }
        }
      }
    },
    "Hide protected app windows until you reveal them.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukrywaj okna chronionych aplikacji, dopóki ich nie odsłonisz."
          }
        }
      }
    },
    "Hold the shortcut to reveal": {
      "localizations": {
