    "Enter pairing code": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz kod parowania"
          }
        }
      }
    },
    "Enter the 26-character code shown under the QR code. Hyphens are optional.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz 26-znakowy kod widoczny pod kodem QR. Myślniki są opcjonalne."
          }
        }
      }
    },
    "Enter the 64-character recovery key created with this vault.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz 64-znakowy klucz odzyskiwania utworzony z tym sejfem."
          }
        }
      }
    },
    "Enter the watch pairing code": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz kod parowania z zegarka"
          }
        }
      }
    },
    "Enter the website address you want Privio to protect.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz adres strony, którą Privio ma chronić."
          }
        }
      }
    },
    "Failed authentication photo": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
