    "Failed unlock attempts": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieudane próby odblokowania"
          }
        }
      }
    },
    "Falls back to your Mac password - e.g. with the lid closed.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Awaryjnie używa hasła Maca - np. przy zamkniętej klapie."
          }
        }
      }
    },
    "Far away": {
