            "state": "translated",
            "value": "Szyfrowany sejf"
          }
        }
      }
    },
    "Enter a Pro license key to unlock Pro features. It’s verified entirely on your Mac - no account, no online activation.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz klucz licencji Pro, aby odblokować funkcje Pro. Weryfikacja odbywa się w całości na Twoim Macu - bez konta i aktywacji online."
          }
