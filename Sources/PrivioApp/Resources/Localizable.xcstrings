      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj ⌥⌘, aby chwilowo odsłonić. Naciśnij ⌥⌘P, aby zablokować lub odblokować odsłonięcie."
