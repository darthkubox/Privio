          }
        }
      }
    },
    "Browsers do not allow a regular Mac app to silently install an unpacked extension. This one-time confirmation is required by the browser.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeglądarki nie pozwalają zwykłej aplikacji Mac instalować rozpakowanego rozszerzenia bez potwierdzenia. Ta jednorazowa czynność jest wymagana przez przeglądarkę."
          }
        }
      }
    },
    "Built for macOS": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stworzone dla macOS"
          }
        }
      }
    },
