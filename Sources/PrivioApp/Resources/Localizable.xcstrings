            "value": "Blokada po odejściu"
          }
        }
      }
    },
    "Proximity auto-lock is part of Privio Pro. Unlock it once, offline, to lock your Mac automatically when your phone, watch or headphones leave.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokada po odejściu jest częścią Privio Pro. Odblokuj ją raz, offline, aby Mac blokował się automatycznie, gdy Twój telefon, zegarek lub słuchawki się oddalą."
          }
        }
      }
    },
