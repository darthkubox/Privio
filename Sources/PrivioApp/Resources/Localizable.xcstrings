          }
        }
      }
    },
    "Back in Privio the status turns Active automatically.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W Privio status zmieni się na Aktywne automatycznie."
          }
        }
      }
    },
    "Block websites in every browser. Turning on sets a local web proxy (asks for your admin password once).": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokuj strony w każdej przeglądarce. Włączenie ustawia lokalne proxy WWW (jednorazowo prosi o hasło administratora)."
          }
        }
      }
    },
