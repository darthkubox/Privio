          }
        }
      }
    },
    "Galaxy Watch briefly connects and disconnects even while it is on your wrist. Automatic locking stays disabled until its nearby BLE signal is identified.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Galaxy Watch na krótko łączy się i rozłącza nawet wtedy, gdy masz go na ręce. Automatyczna blokada pozostanie wyłączona, dopóki nie rozpoznamy jego pobliskiego sygnału BLE."
          }
        }
      }
    },
    "Good to know": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Warto wiedzieć"
          }
        }
      }
    },
