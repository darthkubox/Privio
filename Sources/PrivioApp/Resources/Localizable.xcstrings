    "A Pro feature. Uses a paired Bluetooth device only as a trigger.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Funkcja Pro. Sparowane urządzenie Bluetooth służy wyłącznie jako wyzwalacz."
