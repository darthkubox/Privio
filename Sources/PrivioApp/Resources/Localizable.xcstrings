    "Aliases, symbolic links, and the vault image itself cannot be imported.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można importować aliasów, dowiązań symbolicznych ani samego obrazu sejfu."
          }
        }
      }
    },
    "All configuration stays local.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cała konfiguracja zostaje lokalnie."
          }
        }
      }
    },
    "All files and private notes in this vault will be permanently lost. You will need to confirm with Touch ID or your Mac password.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie pliki i prywatne notatki w tym sejfie zostaną bezpowrotnie utracone. Operację trzeba potwierdzić za pomocą Touch ID lub hasła Maca."
          }
        }
      }
    },
    "All installed apps are already protected": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie zainstalowane aplikacje są już chronione"
          }
        }
      }
    },
    "Allow Bluetooth for Privio in System Settings, then return here.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól Privio na Bluetooth w Ustawieniach systemowych, a następnie wróć tutaj."
          }
        }
      }
    },
    "Always asks for your Mac account password; Touch ID is not used.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zawsze pyta o hasło konta Maca; Touch ID nie jest używany."
          }
        }
      }
    },
