      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj stronę"
          }
        }
      }
    },
    "Add a phone, watch or headphones to use it as an automatic lock trigger.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj telefon, zegarek lub słuchawki, aby używać ich do automatycznego wyzwalania blokady."
          }
        }
      }
    },
    "Add a website to block it in every browser until you unlock with Touch ID.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj stronę, aby zablokować ją w każdej przeglądarce, dopóki nie odblokujesz Touch ID."
          }
        }
      }
    },
    "Add a website to protect it with Touch ID or password.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj stronę, aby chronić ją przez Touch ID lub hasło."
          }
        }
      }
    },
    "Add an application to protect it with Touch ID or password.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj aplikację, aby chronić ją Touch ID lub hasłem."
          }
        }
      }
    },
    "Add files here or open the mounted vault in Finder.": {
      "localizations": {
        "pl": {
          "stringUnit": {
