          }
        }
      }
    },
    "Requires Touch ID. Stops protection, removes Privio’s settings and license, and moves Privio to the Trash. Your protected apps and their data are not touched.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
