            "state": "translated",
            "value": "Privio Pro"
          }
        }
      }
    },
    "Privio Watch": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zegarek Privio"
          }
        }
      }
    },
    "Privio can’t protect itself.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Privio nie może chronić samego siebie."
          }
        }
      }
    },
    "Privio is Active": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Privio jest aktywne"
          }
        }
      }
    },
    "Privio is Off": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Privio jest wyłączone"
          }
        }
      }
    },
    "Privio is active": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Privio jest aktywne"
          }
        }
      }
    },
    "Privio is locked": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Privio jest zablokowane"
          }
        }
      }
    },
    "Privio needs Bluetooth to see your devices. Turn it on for Privio in System Settings.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Privio potrzebuje Bluetooth, aby widzieć Twoje urządzenia. Włącz je dla Privio w Ustawieniach systemowych."
          }
        }
      }
    },
    "Privio needs the camera to scan the watch QR code. Turn it on for Privio in System Settings, then scan again. You can also use „Enter code” instead.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Privio potrzebuje kamery, aby zeskanować kod QR z zegarka. Włącz ją dla Privio w Ustawieniach systemowych i zeskanuj ponownie. Możesz też użyć „Wpisz kod”."
          }
        }
      }
    },
    "Privio never measures how you use it.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Privio nigdy nie mierzy, jak go używasz."
          }
        }
      }
    },
    "Privio protects access to an app’s interface - not the app’s files, databases or exports on disk.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Privio chroni dostęp do interfejsu aplikacji - nie jej plików, baz danych ani eksportów na dysku."
          }
        }
      }
    },
    "Privio sends no usage data to us.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Privio nie wysyła nam danych o sposobie używania."
          }
        }
      }
    },
    "Privio will close %@ automatically after inactivity. Any unsaved changes in %@ may be lost - especially with “Force quit if it doesn’t respond” turned on. Are you sure you want to enable auto-quit?": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Privio automatycznie zamknie %@ po bezczynności. Niezapisane zmiany w %@ mogą zostać utracone - zwłaszcza przy włączonym „Wymuś zamknięcie, jeśli nie odpowiada”. Na pewno włączyć auto-zamykanie?"
          }
        }
      }
    },
    "PrivioWear detected - confirm it using the pairing QR or code above.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wykryto PrivioWear - potwierdź urządzenie kodem QR lub kodem parowania powyżej."
          }
        }
      }
    },
