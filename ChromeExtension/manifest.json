{
  "manifest_version": 3,
  "name": "Privio Website Protection",
  "version": "0.1.14",
  "description": "Requests Privio authentication only for real top-level website navigations.",
  "permissions": ["alarms", "declarativeNetRequest", "storage", "tabs", "webNavigation", "windows"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:8987/*"],
  "background": { "service_worker": "service-worker.js" },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["blocker.js"],
    "run_at": "document_start",
    "all_frames": false
  }],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Privio Website Protection",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16-active.png",
      "32": "icons/icon32-active.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [{
    "resources": ["unlock.html", "unlock.js", "unlock.css"],
    "matches": ["<all_urls>"]
  }]
}
